{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markumo",
  "version": "1.1.0",
  "identifier": "com.markumo.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Markumo",
        "width": 1200,
        "height": 780,
        "minWidth": 680,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; font-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'",
      "devCsp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; font-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "icons/document.ico": "icons/document.ico",
      "../LICENSE": "LICENSE"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installerHooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "png",
          "apng",
          "jpg",
          "jpeg",
          "jfif",
          "gif",
          "webp",
          "bmp",
          "svg",
          "ico",
          "cur",
          "avif"
        ],
        "name": "Markumo.ImageFile",
        "description": "图片 (Markumo)",
        "role": "Viewer"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "Markumo.PdfDocument",
        "description": "PDF 文档 (Markumo)",
        "role": "Viewer",
        "mimeType": "application/pdf"
      },
      {
        "ext": [
          "txt",
          "log",
          "ini",
          "cfg",
          "conf",
          "properties"
        ],
        "name": "Markumo.TextDocument",
        "description": "文本文档 (Markumo)",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markumo.MarkdownDocument",
        "description": "Markdown 文档 (Markumo)",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": [
          "json",
          "jsonc"
        ],
        "name": "Markumo.JsonDocument",
        "description": "JSON 文档 (Markumo)",
        "role": "Editor",
        "mimeType": "application/json"
      },
      {
        "ext": [
          "xml",
          "yaml",
          "yml"
        ],
        "name": "Markumo.DataFile",
        "description": "配置文件 (Markumo)",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "js",
          "jsx",
          "ts",
          "tsx",
          "vue",
          "html",
          "css",
          "scss"
        ],
        "name": "Markumo.WebSourceFile",
        "description": "Web 源文件 (Markumo)",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "java",
          "py",
          "go",
          "rs",
          "sql",
          "sh"
        ],
        "name": "Markumo.SourceCodeFile",
        "description": "源代码文件 (Markumo)",
        "role": "Editor",
        "mimeType": "text/plain"
      }
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3RTdBQzBBRTE5NEFGQjQKUldTMHI1VGhDcXpuSncvbnRrQU5WTlFaTi96ckg2ZW1JSTcwb1VtVUROK0FwMENTejNpeDl5SCsK",
      "endpoints": [
        "https://github.com/yuanmahome/Markumo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

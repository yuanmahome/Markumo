{
  "primaryStatistic": "words",
  "bracketMode": "matching",
  "syntaxStyle": "vivid",
  "autoCheckUpdates": true,
  "autoDownloadUpdates": false,
  "caretAnimation": "smooth",
  "outlineWidth": 240,
  "markdownClipboard": {
    "copyAcrossBlocks": true,
    "copyWholeLine": false
  },
  "markdownTypography": {
    "width": 860,
    "fontSize": 16,
    "fontFamily": "system",
    "lineHeight": 1.6,
    "codeLineNumbers": true,
    "codeWrap": true,
    "imageBorder": true
  },
  "theme": "system",
  "uiFontSize": 14,
  "fontSize": 14,
  "fontFamily": "system",
  "wordWrap": true,
  "showOutline": false,
  "typewriterMode": false,
  "indentSize": 2,
  "useTabs": false,
  "defaultMdMode": "live",
  "liveToolbar": true,
  "externalFileMonitoring": true,
  "autoReloadExternal": true,
  "autoSave": false,
  "autoSaveDelay": 1500,
  "treeClickMode": "single",
  "autoFollowActiveFile": false,
  "smartExpand": true,
  "compactFolders": false,
  "keymapPreset": "markumo",
  "imageRules": {
    "location": "assets",
    "customDirectory": "./assets/",
    "relative": true,
    "dotPrefix": true,
    "escape": true
  },
  "documentImageRules": {},
  "settingsVersion": 7,
  "shortcutVersion": 4,
  "customShortcuts": [],
  "shortcuts": {
    "new": "Mod+N",
    "open": "Mod+O",
    "quick-open": "Mod+P",
    "save": "Mod+S",
    "save-as": "Mod+Shift+S",
    "close-current": "Mod+W",
    "palette": "Mod+Shift+P",
    "explorer": "Alt+1",
    "sidebar": "Mod+Alt+B",
    "goto-line": "Mod+G",
    "next-tab": "Mod+PageDown",
    "previous-tab": "Mod+PageUp",
    "recent-tab": "Mod+Tab",
    "show-open-tabs": "",
    "undo": "Mod+Z",
    "redo": "Mod+Y",
    "delete-line": "Mod+Shift+K",
    "move-line-up": "Alt+ArrowUp",
    "move-line-down": "Alt+ArrowDown",
    "copy-line-down": "Alt+Shift+ArrowDown",
    "comment-line": "Mod+/",
    "fold-code": "Mod+Alt+[",
    "unfold-code": "Mod+Alt+]",
    "uppercase": "Mod+Alt+U",
    "lowercase": "Mod+Alt+L",
    "find": "Mod+F",
    "replace": "Mod+R",
    "find-next": "F3",

    "close-pane": "Mod+Alt+W",
    "merge-splits": "Mod+Shift+M",
    "bold": "Mod+B",
    "italic": "Mod+I",
    "strike": "Alt+Shift+5",
    "inline-code": "Mod+Shift+`",
    "link": "Mod+K",

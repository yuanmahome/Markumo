    "code-block": "Mod+Alt+C",
    "table": "Mod+T",
    "quote": "Mod+Shift+Q",
    "heading-1": "Mod+1",
    "heading-2": "Mod+2",
    "heading-3": "Mod+3",
    "heading-4": "Mod+4",
    "heading-5": "Mod+5",
    "heading-6": "Mod+6",
    "heading-0": "Mod+0",
    "toggle-outline": "Mod+Shift+O",
    "md-mode-live": "Mod+Alt+1",
    "md-mode-source": "Mod+Alt+2",
    "md-mode-split": "Mod+Alt+3",
    "zoom-in": "Mod+=",
